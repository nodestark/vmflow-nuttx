#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config VMFLOW_MDB
	tristate "MDB cashless engine (mdb)"
	default n
	depends on !DISABLE_MQUEUE
	---help---
		Answers the vending machine as an MDB level 1 cashless device on
		the bus driver (/dev/mdb0), like mdb_cashless_task() in the
		ESP-IDF firmware. Any task drives it through a message queue
		(mdb.h, or the "mdb" command): open a session with credit, let
		the app approve each vend, cancel, and so on.

if VMFLOW_MDB

config VMFLOW_MDB_PROGNAME
	string "Program name"
	default "mdb"

config VMFLOW_MDB_PRIORITY
	int "Engine task priority"
	default 200
	---help---
		The VMC wants an answer within 5 ms; keep it above the network
		and modem tasks.

config VMFLOW_MDB_STACKSIZE
	int "Stack size"
	default 2048

config VMFLOW_MDB_AUTOSTART
	bool "Start at boot (nxinit service)"
	default y
	depends on SYSTEM_NXINIT
	---help---
		Run "mdb" as an nxinit service from /etc/init.d/init.rc.

config VMFLOW_MDB_DEVPATH
	string "MDB bus device"
	default "/dev/mdb0"

choice
	prompt "Peripheral address"
	default VMFLOW_MDB_CASHLESS_1

config VMFLOW_MDB_CASHLESS_1
	bool "Cashless device #1 (0x10)"

config VMFLOW_MDB_CASHLESS_2
	bool "Cashless device #2 (0x60)"

endchoice

config VMFLOW_MDB_ADDRESS
	int
	default 16 if VMFLOW_MDB_CASHLESS_1
	default 96 if VMFLOW_MDB_CASHLESS_2

choice
	prompt "Country / currency code"
	default VMFLOW_MDB_CURRENCY_UNKNOWN

config VMFLOW_MDB_CURRENCY_EUR
	bool "EUR - 0x1978"

config VMFLOW_MDB_CURRENCY_USD
	bool "USD - 0x1840"

config VMFLOW_MDB_CURRENCY_BRL
	bool "BRL - 0x1986"

config VMFLOW_MDB_CURRENCY_UNKNOWN
	bool "Unknown - 0xffff"

endchoice

config VMFLOW_MDB_CURRENCY_CODE
	int
	default 6520 if VMFLOW_MDB_CURRENCY_EUR
	default 6208 if VMFLOW_MDB_CURRENCY_USD
	default 6534 if VMFLOW_MDB_CURRENCY_BRL
	default 65535 if VMFLOW_MDB_CURRENCY_UNKNOWN

choice
	prompt "Scale factor"
	default VMFLOW_MDB_SCALE_1

config VMFLOW_MDB_SCALE_1
	bool "1"

config VMFLOW_MDB_SCALE_10
	bool "10"

config VMFLOW_MDB_SCALE_100
	bool "100"

endchoice

config VMFLOW_MDB_SCALE_FACTOR
	int
	default 1 if VMFLOW_MDB_SCALE_1
	default 10 if VMFLOW_MDB_SCALE_10
	default 100 if VMFLOW_MDB_SCALE_100

config VMFLOW_MDB_DECIMAL_PLACES
	int "Decimal places"
	default 2
	range 0 3

config VMFLOW_MDB_SESSION_TIMEOUT
	int "Session inactivity timeout (s)"
	default 60
	---help---
		A session with no vend activity for this long is cancelled. Each
		vend request and outcome restarts the count.

config VMFLOW_MDB_APPROVE_TIMEOUT
	int "Vend approval timeout (s)"
	default 8
	range 1 255
	---help---
		A vend in an "open" session that gets no approve/deny for this
		long is denied. Keep it below the response time reported to the
		VMC, so the reader answers before the VMC gives up.

config VMFLOW_MDB_RESPONSE_TIME
	int "Maximum response time reported to the VMC (s)"
	default 10
	range 1 255
	---help---
		Sent in READER CONFIG DATA: how long the VMC waits for the
		reader, notably for a vend approval. The ESP-IDF firmware sends
		3; an approval that crosses LTE-M needs more.

config VMFLOW_MDB_BUS_TIMEOUT
	int "Bus silence timeout (s)"
	default 5
	---help---
		With no frame for the reader for this long (machine off, cable
		out), the reader drops to inactive, the session ends and the
		next poll is answered with JUST RESET.

config VMFLOW_MDB_CREDIT_TIMEOUT
	int "Pending credit timeout (s)"
	default 120
	---help---
		A credit that finds no session for this long (reader not
		enabled) is dropped, with a credit_expired event so the sender
		can give it back. Each new credit restarts the count.

config VMFLOW_MDB_WATCHDOG
	bool "Hardware watchdog"
	default y
	depends on WATCHDOG
	---help---
		The engine starts the watchdog and feeds it at least once a
		second. If the engine stops (and init does not bring it back in
		time), the board resets.

config VMFLOW_MDB_WATCHDOG_DEVPATH
	string "Watchdog device"
	default "/dev/watchdog0"
	depends on VMFLOW_MDB_WATCHDOG

config VMFLOW_MDB_WATCHDOG_TIMEOUT
	int "Watchdog timeout (s)"
	default 10
	depends on VMFLOW_MDB_WATCHDOG

endif
