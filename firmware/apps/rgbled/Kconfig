#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config VMFLOW_RGBLED
	tristate "RGB LED (WS2812)"
	default n
	depends on WS2812_NON_SPI_DRIVER
	---help---
		Command to drive the board's addressable RGB LED through the
		WS2812 driver: solid colors, brightness, blink and a rainbow test.

if VMFLOW_RGBLED

config VMFLOW_RGBLED_PROGNAME
	string "Program name"
	default "rgbled"

config VMFLOW_RGBLED_PRIORITY
	int "Task priority"
	default 100

config VMFLOW_RGBLED_STACKSIZE
	int "Stack size"
	default 2048

config VMFLOW_RGBLED_DEVPATH
	string "WS2812 device"
	default "/dev/leds0"

endif
