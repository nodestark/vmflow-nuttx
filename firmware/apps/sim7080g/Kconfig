#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config SIM7080G
	tristate "SIM7080G LTE-M / NB-IoT modem daemon"
	default n
	depends on NET_UDP && NET_IPv4 && DEV_GPIO
	select NETUTILS_PPPD
	select NETUTILS_NETLIB
	---help---
		Powers the SIM7080G, runs pppd over its UART and supervises the
		PPP link. Once IPCP is up the modem is a regular network interface
		(ppp0): sockets, DNS, MQTT and TLS work without knowing about it.

if SIM7080G

config SIM7080G_PROGNAME
	string "Program name"
	default "sim7080g"

config SIM7080G_PRIORITY
	int "Daemon task priority"
	default 100

config SIM7080G_STACKSIZE
	int "Daemon stack size"
	default 2048

config SIM7080G_PPP_PRIORITY
	int "pppd task priority"
	default 100

config SIM7080G_PPP_STACKSIZE
	int "pppd stack size"
	default 4096

config SIM7080G_TTY
	string "Modem serial device"
	default "/dev/ttyS1"

config SIM7080G_PWRKEY
	string "PWRKEY GPIO device"
	default "/dev/sim7080g_pwrkey"

config SIM7080G_APN
	string "APN"
	default "lf.br"

choice
	prompt "LTE network mode"
	default SIM7080G_CMNB_BOTH

config SIM7080G_CMNB_CATM
	bool "Cat-M only"

config SIM7080G_CMNB_NBIOT
	bool "NB-IoT only"

config SIM7080G_CMNB_BOTH
	bool "Both (LTE-M + NB-IoT)"

endchoice

config SIM7080G_CMNB
	int
	default 1 if SIM7080G_CMNB_CATM
	default 2 if SIM7080G_CMNB_NBIOT
	default 3 if SIM7080G_CMNB_BOTH

config SIM7080G_LINK_TIMEOUT
	int "Seconds without link before toggling PWRKEY"
	default 300
	---help---
		pppd retries the connect script on its own (every 10 s, plus a
		45 s pause after 15 failures). If ppp0 still has no address after
		this many seconds, the daemon pulses PWRKEY to power-cycle a stuck
		modem.

if NETUTILS_PPPD_PAP

config SIM7080G_PAP_USERNAME
	string "PAP username"
	default ""

config SIM7080G_PAP_PASSWORD
	string "PAP password"
	default ""

endif # NETUTILS_PPPD_PAP

endif # SIM7080G
