############################################################################
# firmware/apps/sim7080g/Make.defs
############################################################################

ifneq ($(CONFIG_SIM7080G),)
CONFIGURED_APPS += $(APPDIR)/external/sim7080g
endif

# apps/netutils/pppd only asks the peer for DNS servers (IPCP options 129/131)
# when these are defined. Every app Makefile includes this file, so scope the
# flags to the pppd directory instead of patching the submodule.

ifneq ($(CONFIG_SIM7080G),)
ifeq ($(notdir $(CURDIR)),pppd)
CFLAGS += -DIPCP_GET_PRI_DNS -DIPCP_GET_SEC_DNS
endif
endif
