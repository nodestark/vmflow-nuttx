#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config VMFLOW_DEX
	tristate "EVA-DTS audit reader (dex)"
	default n
	depends on SERIAL_TERMIOS
	---help---
		Reads the vending machine's EVA-DTS audit data over the DEX port,
		trying DDCMP (2400 baud) and then DEX/UCS (9600 baud), like
		eva-dts.c in the ESP-IDF firmware, and prints it on stdout.

if VMFLOW_DEX

config VMFLOW_DEX_PROGNAME
	string "Program name"
	default "dex"

config VMFLOW_DEX_PRIORITY
	int "Task priority"
	default 100

config VMFLOW_DEX_STACKSIZE
	int "Stack size"
	default 3072

config VMFLOW_DEX_TTY
	string "DEX serial device"
	default "/dev/ttyS2"

config VMFLOW_DEX_BUFSIZE
	int "Audit buffer size"
	default 8192
	---help---
		Largest audit kept; the rest is dropped.

endif
