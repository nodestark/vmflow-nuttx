#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config VMFLOW
	tristate "VMflow orchestrator"
	default n
	depends on NET_TCP && NETDB_DNSCLIENT
	select NETUTILS_MQTTC
	---help---
		Ties the VMflow backend (MQTT) and the phone app (BLE) to the MDB
		engine, the dex audit reader, the buzzer and the status LED, as
		the ESP-IDF firmware does. It only talks to them through their
		public interfaces (mdb.h, the dex command, device files), so the
		rest of the system runs without it.

if VMFLOW

config VMFLOW_PROGNAME
	string "Program name"
	default "vmflow"

config VMFLOW_PRIORITY
	int "Task priority"
	default 100

config VMFLOW_STACKSIZE
	int "Stack size (MQTT client)"
	default 4096

config VMFLOW_MACHINE_STACKSIZE
	int "Stack size of the MDB event thread"
	default 3072

config VMFLOW_AUTOSTART
	bool "Start at boot (nxinit service)"
	default y
	depends on SYSTEM_NXINIT
	---help---
		Run "vmflow" as an nxinit service from /etc/init.d/init.rc. It
		waits for its identity files and for the network on its own.

config VMFLOW_DATADIR
	string "Identity directory"
	default "/data/vmflow"
	---help---
		Holds "subdomain" (the numeric device id of the backend,
		<subdomain>.vmflow.xyz) and "passkey" (RPC and BLE signing key),
		one value per file:
		  echo 123 > /data/vmflow/subdomain
		The ESP-IDF firmware keeps them in NVS.

config VMFLOW_BUZZER_DEVPATH
	string "Buzzer GPIO device"
	default "/dev/gpio0"

config VMFLOW_LED_DEVPATH
	string "Status LED device"
	default "/dev/leds0"

config VMFLOW_DEX_COMMAND
	string "Audit reader command"
	default "dex"
	---help---
		Builtin run for the "dex" RPC; its stdout is the audit.

config VMFLOW_BLE
	bool "BLE for the phone app"
	default y
	depends on NIMBLE && NIMBLE_ROLE_PERIPHERAL
	---help---
		GATT peripheral of the ESP-IDF firmware (same service): BLE
		provisioning of subdomain and passkey, app sessions with signed
		vend approval, and vend notifications. Builds NimBLE into vmflow.

config VMFLOW_BLE_IFNAME
	string "BLE controller network interface"
	default "bnep0"
	depends on VMFLOW_BLE

config VMFLOW_BLE_STACKSIZE
	int "Stack size of the NimBLE host and HCI threads"
	default 4096
	depends on VMFLOW_BLE

config VMFLOW_MQTT_HOST
	string "Broker host"
	default "mqtt.vmflow.xyz"

config VMFLOW_MQTT_PORT
	int "Broker port"
	default 1883

config VMFLOW_MQTT_KEEPALIVE
	int "Keepalive (s)"
	default 120

config VMFLOW_MQTT_RECONNECT
	int "Seconds between connection attempts"
	default 15

config VMFLOW_MQTT_SENDBUF
	int "Send buffer size"
	default 10240
	---help---
		MQTT-C keeps every outgoing message here until it is
		acknowledged. A DEX audit (up to the dex buffer, 8 KB) goes out
		as one message; larger audits are cut to fit.

config VMFLOW_MQTT_RECVBUF
	int "Receive buffer size"
	default 2048
	---help---
		Largest incoming message (topic + payload).

endif
